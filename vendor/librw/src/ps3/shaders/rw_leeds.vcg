// rw_leeds.vcg -- the Leeds world pipeline (LCS buildings and map objects),
// as reLCS's leedsBuilding.vert with its PS2 settings: the prelit colour
// lit by the time cycle's ambient, plus the ambient light as emission,
// alpha from the material (distance fading). rw_leeds.fcg scales the
// textured result: PS2 vertex colours go to 128, not 255.
//
// patch 34: only the registers every other program uses. Patches 27 and 33
// had the time cycle ambient and the colour scale in C15 and handed the
// scale to the fragment program in TEXCOORD1: on the console every Leeds
// model came out black, with the values right (the [leeds] log). Now the
// ambient comes in u_matColor.rgb (leedsRenderCB puts it there, with the
// material's alpha in .a) and the scale is a literal of rw_leeds.fcg.
#include "common.cgh"

void main(float4 in_pos    : ATTR0,
          float4 in_color  : ATTR3,
          float2 in_tex0   : ATTR8,
          out float4 o_pos   : POSITION,
          out float4 o_color : COLOR0,
          out float2 o_tex0  : TEXCOORD0,
          out float4 o_fog   : TEXCOORD2)
{
	float4 p = float4(in_pos.xyz, 1.0);
	o_pos = Transform(p);
	float4 c = in_color;
	c.rgb = c.rgb * u_matColor.rgb + u_ambLight.rgb * u_surfProps.w;
	// as DoColor: saturate in a temporary, one full write of the output
	o_color = saturate(c) * float4(1.0, 1.0, 1.0, u_matColor.a);
	o_tex0 = in_tex0;
	o_fog = DoFog(o_pos.w);
}
